<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xaubot.newsupdater</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/XAU-RSI-Reversal-50-EMA-Bot/venv/bin/python3</string>
        <string>-u</string>
        <string>/path/to/XAU-RSI-Reversal-50-EMA-Bot/update_news_csv.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/XAU-RSI-Reversal-50-EMA-Bot</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>2</integer>   <!-- Monday (1=Sun, 2=Mon) -->
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/path/to/XAU-RSI-Reversal-50-EMA-Bot/news_update.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/XAU-RSI-Reversal-50-EMA-Bot/news_update.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
